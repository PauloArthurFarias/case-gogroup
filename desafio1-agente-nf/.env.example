# Copie para .env e preencha. O .env fica só na sua máquina (está no .gitignore).
# Sem nenhuma chave de IA, o agente roda em modo offline (regras determinísticas + extração por regex).

# ---------------------------------------------------------------- IA
# Provedor: "anthropic" (Claude) ou "openai_compat" (OpenRouter, Ollama ou outra API compatível com OpenAI)
AP_LLM_PROVEDOR=anthropic

# Opção 1: Claude
ANTHROPIC_API_KEY=
AP_MODELO_EXTRACAO=claude-haiku-4-5
AP_MODELO_AGENTE=claude-sonnet-5-5

# Opção 2: modelo gratuito via OpenRouter (ex.: Qwen). Crie a chave em https://openrouter.ai/settings/keys
# AP_LLM_PROVEDOR=openai_compat
# AP_LLM_BASE_URL=https://openrouter.ai/api/v1
# AP_LLM_API_KEY=sk-or-...
# AP_LLM_MODELO=<id de um modelo gratuito com suporte a ferramentas; veja o README>

# ------------------------------------------------------------- E-mail
# Caixa que recebe as notas. No Gmail: ative a verificação em duas etapas e crie uma "senha de app".
AP_EMAIL_IMAP_HOST=imap.gmail.com
AP_EMAIL_USUARIO=
AP_EMAIL_SENHA=
AP_EMAIL_PASTA=INBOX

# ------------------------------------------------------------- Regras
# CNPJ da empresa destinatária (a "nossa" empresa)
AP_CNPJ_EMPRESA=11222333000181
# Tolerância de preço no match NF x pedido (%)
AP_TOLERANCIA_PRECO=2.0
# Dias para alerta de vencimento próximo
AP_DIAS_ALERTA_VENCIMENTO=3
# Abaixo desta confiança de extração, o documento vai para revisão
AP_CONFIANCA_MINIMA=0.85

# Pastas (opcional): permite um ambiente separado, ex.: notas reais
# AP_DATA_DIR=
# AP_INBOX_DIR=
