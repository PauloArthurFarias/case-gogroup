# Copie para .env (fica só na sua máquina; está no .gitignore) e preencha o que tiver.
# Depois, com o n8n rodando:  python scripts/configurar.py

# --- Aprovação humana pelo Telegram (opcional)
# Token do bot criado no @BotFather. Antes de configurar, mande /start para o seu bot.
TELEGRAM_BOT_TOKEN=
# true = todo vídeo espera "Publicar"/"Descartar" no Telegram antes de ir ao TikTok
EXIGIR_APROVACAO=true

# --- App do TikTok for Developers (sandbox)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL HTTPS do túnel + /webhook/tiktok/callback (a mesma cadastrada no app do TikTok)
TIKTOK_REDIRECT_URI=
# simulador (padrão) ou real
TIKTOK_MODO=simulador

# --- Roteiro por IA (credencial "OpenRouter" no n8n). Vazio = reaproveita a chave do Desafio 1.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=nvidia/nemotron-3-super-120b-a12b:free

# --- Provedor reserva de IA (gratuito): chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# vazio = escolhe automaticamente o Flash estável mais recente
GEMINI_MODELO=

# --- Fotos de fundo do vídeo (gratuito): chave da API do Pexels (https://www.pexels.com/api/)
PEXELS_API_KEY=
