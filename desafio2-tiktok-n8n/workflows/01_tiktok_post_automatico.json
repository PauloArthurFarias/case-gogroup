    {
      "id": "dd93f90c-4d57-516b-becd-a7f5a4909664",
      "name": "OpenRouter: gerar roteiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Title",
              "value": "Case GoGroup - TikTok automatico"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Config').first().json.modelo_openrouter,\n  temperature: 0.8,\n  response_format: { type: 'json_schema', json_schema: { name: 'roteiro', schema: {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"tema\", \"gancho\", \"cenas\", \"cta\", \"hashtags\"], \"properties\": {\"tema\": {\"type\": \"string\"}, \"gancho\": {\"type\": \"string\", \"description\": \"Frase de até 12 palavras para prender nos 2 primeiros segundos\"}, \"cenas\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"texto\", \"narracao\"], \"properties\": {\"texto\": {\"type\": \"string\", \"description\": \"Texto na tela, até 8 palavras\"}, \"narracao\": {\"type\": \"string\", \"description\": \"Fala da cena, 1 a 2 frases\"}}}}, \"cta\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}} } },\n  messages: [\n    { role: 'system', content: \"Você é roteirista de vídeos curtos (TikTok, 20 a 40 segundos) de um perfil brasileiro sobre automação, IA e produtividade para empresas (financeiro, indústria, supply, RPA, n8n).\\n\\nEscreva em português do Brasil, tom direto e próximo, sem jargão desnecessário.\\n\\nEstrutura obrigatória:\\n- gancho: até 12 palavras, provocativo, que prenda nos 2 primeiros segundos (pergunta, dado surpreendente ou erro comum).\\n- cenas: 3 ou 4 cenas. Em cada uma, `texto` é o que aparece na tela (até 8 palavras) e `narracao` é a fala (1 a 2 frases curtas, até 25 palavras).\\n- cta: chamada final curta (seguir, comentar uma palavra, salvar).\\n- hashtags: 4 a 6, minúsculas, relevantes em português.\\n\\nRegras:\\n- Uma ideia prática e verdadeira por vídeo. Nada de promessas exageradas (\\\"fique rico\\\", \\\"100% garantido\\\").\\n- Não cite marcas, empresas ou pessoas reais.\\n- Duração total da narração: até 40 segundos (cerca de 100 palavras).\\n\\n\\nResponda SOMENTE com o JSON do roteiro.\" },\n    { role: 'user', content: 'Tema: ' + ($('Config').first().json.tema || 'escolha um tema útil de automação para empresas') }\n  ]\n}) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "notes": "Modelo gratuito via OpenRouter (credencial Header Auth 'OpenRouter'). Falhou? banco de roteiros."
    },
    {
      "id": "0cca4641-58b5-5913-a267-4f155868c3d2",
      "name": "Ler resposta (OpenRouter)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        200
      ],
      "parameters": {
        "jsCode": "const r = $json;\nif (r.error) throw new Error('OpenRouter: ' + JSON.stringify(r.error));\nconst texto = r.choices?.[0]?.message?.content || '';\nconst m = texto.match(/\\{[\\s\\S]*\\}/);\nif (!m) throw new Error('Resposta sem JSON');\nreturn [{ json: { ...JSON.parse(m[0]), origem: 'ia:' + (r.model || 'openrouter'),\n  tokens: r.usage?.total_tokens || 0 } }];\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "f171f555-c7d4-5c6b-bc05-488469b7cae6",
      "name": "Claude: gerar roteiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.modelo,\n  max_tokens: 4000,\n  fallbacks: 'default',\n  output_config: { effort: 'low', format: { type: 'json_schema', schema: {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"tema\", \"gancho\", \"cenas\", \"cta\", \"hashtags\"], \"properties\": {\"tema\": {\"type\": \"string\"}, \"gancho\": {\"type\": \"string\", \"description\": \"Frase de até 12 palavras para prender nos 2 primeiros segundos\"}, \"cenas\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"texto\", \"narracao\"], \"properties\": {\"texto\": {\"type\": \"string\", \"description\": \"Texto na tela, até 8 palavras\"}, \"narracao\": {\"type\": \"string\", \"description\": \"Fala da cena, 1 a 2 frases\"}}}}, \"cta\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}} } },\n  system: \"Você é roteirista de vídeos curtos (TikTok, 20 a 40 segundos) de um perfil brasileiro sobre automação, IA e produtividade para empresas (financeiro, indústria, supply, RPA, n8n).\\n\\nEscreva em português do Brasil, tom direto e próximo, sem jargão desnecessário.\\n\\nEstrutura obrigatória:\\n- gancho: até 12 palavras, provocativo, que prenda nos 2 primeiros segundos (pergunta, dado surpreendente ou erro comum).\\n- cenas: 3 ou 4 cenas. Em cada uma, `texto` é o que aparece na tela (até 8 palavras) e `narracao` é a fala (1 a 2 frases curtas, até 25 palavras).\\n- cta: chamada final curta (seguir, comentar uma palavra, salvar).\\n- hashtags: 4 a 6, minúsculas, relevantes em português.\\n\\nRegras:\\n- Uma ideia prática e verdadeira por vídeo. Nada de promessas exageradas (\\\"fique rico\\\", \\\"100% garantido\\\").\\n- Não cite marcas, empresas ou pessoas reais.\\n- Duração total da narração: até 40 segundos (cerca de 100 palavras).\\n\",\n  messages: [{ role: 'user', content: 'Tema: ' + ($json.tema || 'escolha um tema útil de automação para empresas') }]\n}) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "Structured output: a resposta é JSON garantido pelo schema. Falhou? cai no banco de roteiros."
    },
    {
      "id": "ef28eccb-7943-5e9b-9312-9d180db31ff1",
      "name": "Ler resposta da IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        20
      ],
      "parameters": {
        "jsCode": "const r = $json;\nif (r.stop_reason === 'refusal') throw new Error('Claude recusou: ' + JSON.stringify(r.stop_details));\nif (r.stop_reason === 'max_tokens') throw new Error('Resposta truncada (max_tokens)');\nconst texto = (r.content || []).find(b => b.type === 'text')?.text;\nif (!texto) throw new Error('Resposta sem bloco de texto');\nreturn [{ json: { ...JSON.parse(texto), origem: 'ia:' + r.model,\n  tokens: (r.usage?.input_tokens || 0) + (r.usage?.output_tokens || 0) } }];\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "78922121-d87c-5913-b38b-a72f37100057",
      "name": "Banco de roteiros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        400
      ],
      "parameters": {
        "jsCode": "// Banco de roteiros: usado quando a IA está desligada (sem chave) ou falha.\n// Escolhe pelo tema informado (busca por palavra) ou faz rodízio pelo dia do ano.\nconst banco = [\n  {\n    tema: \"nota fiscal\",\n    gancho: \"Seu time ainda digita nota fiscal à mão?\",\n    cenas: [\n      { texto: \"O XML da NF-e já traz tudo pronto\", narracao: \"O XML da nota fiscal eletrônica já traz todos os dados prontos. Digitar é desperdício.\" },\n      { texto: \"Um robô confere com o pedido de compra\", narracao: \"Um robô lê o XML e confere item a item com o pedido de compra e com o que chegou no almoxarifado.\" },\n      { texto: \"Só as exceções chegam para você\", narracao: \"Você só olha as exceções: preço diferente, quantidade a mais ou nota duplicada.\" },\n    ],\n    cta: \"Quer o passo a passo? Siga para a parte 2!\",\n    hashtags: [\"#automacao\", \"#rpa\", \"#financeiro\", \"#notafiscal\", \"#produtividade\"],\n  },\n  {\n    tema: \"golpe do boleto\",\n    gancho: \"Esse boleto parece certo. Mas é golpe.\",\n    cenas: [\n      { texto: \"Nome do fornecedor certo, CNPJ errado\", narracao: \"No golpe do boleto, o nome do fornecedor está certo, mas o CNPJ do beneficiário é de outra pessoa.\" },\n      { texto: \"A automação compara com o cadastro\", narracao: \"Uma automação simples compara o beneficiário com o cadastro de fornecedores antes de pagar.\" },\n      { texto: \"E valida os dígitos da linha digitável\", narracao: \"E ainda valida os dígitos verificadores da linha digitável e o valor do código de barras.\" },\n    ],\n    cta: \"Salve este vídeo e mostre para o seu financeiro!\",\n    hashtags: [\"#golpedoboleto\", \"#seguranca\", \"#financeiro\", \"#automacao\", \"#dica\"],\n  },\n  {\n    tema: \"n8n\",\n    gancho: \"Automatizei meu TikTok com n8n. Sem programar.\",\n    cenas: [\n      { texto: \"A IA escreve o roteiro\", narracao: \"Primeiro, uma IA escreve o roteiro com gancho, cenas e chamada para ação.\" },\n      { texto: \"O vídeo é montado sozinho\", narracao: \"Depois o vídeo é montado sozinho: narração, legendas e formato vertical.\" },\n      { texto: \"E publicado pela API oficial\", narracao: \"Por fim, o n8n publica pela API oficial do TikTok e registra tudo numa planilha.\" },\n    ],\n    cta: \"Comenta 'n8n' que eu te mando o fluxo!\",\n    hashtags: [\"#n8n\", \"#automacao\", \"#nocode\", \"#ia\", \"#tiktokdicas\"],\n  },\n  {\n    tema: \"chão de fábrica\",\n    gancho: \"Sua fábrica perde dinheiro em paradas que ninguém registra.\",\n    cenas: [\n      { texto: \"Operador manda áudio no WhatsApp\", narracao: \"O operador só manda um áudio no WhatsApp dizendo o que parou e por quê.\" },\n      { texto: \"A IA classifica a causa\", narracao: \"A inteligência artificial transcreve, classifica a causa e calcula o tempo parado.\" },\n      { texto: \"O gestor recebe o relatório do turno\", narracao: \"No fim do turno, o gestor recebe o relatório pronto, com as maiores perdas.\" },\n    ],\n    cta: \"Siga para ver mais automações industriais!\",\n    hashtags: [\"#industria\", \"#manufatura\", \"#automacao\", \"#ia\", \"#oee\"],\n  },\n  {\n    tema: \"planilha\",\n    gancho: \"3 tarefas de planilha que um robô faz por você.\",\n    cenas: [\n      { texto: \"1. Juntar relatórios de vários e-mails\", narracao: \"Um: juntar relatórios que chegam em vários e-mails numa planilha só.\" },\n      { texto: \"2. Conciliar extrato com contas a pagar\", narracao: \"Dois: conciliar o extrato do banco com o contas a pagar.\" },\n      { texto: \"3. Mandar alerta de vencimento\", narracao: \"Três: mandar alerta antes de cada vencimento, para nunca mais pagar juros.\" },\n    ],\n    cta: \"Qual dessas você quer aprender? Comenta!\",\n    hashtags: [\"#excel\", \"#planilha\", \"#automacao\", \"#rpa\", \"#produtividade\"],\n  },\n];\n\nconst tema = ($json.tema || \"\").toString().trim();\nconst normalizar = (s) => s.normalize(\"NFD\").replace(/[̀-ͯ]/g, \"\").toLowerCase();\nlet escolhido = tema\n  ? banco.find((r) => normalizar(tema).includes(normalizar(r.tema)) || normalizar(r.tema).includes(normalizar(tema)))\n  : null;\nif (!escolhido) {\n  const inicio = new Date(new Date().getFullYear(), 0, 0);\n  const diaDoAno = Math.floor((Date.now() - inicio) / 86400000);\n  escolhido = banco[diaDoAno % banco.length];\n}\nreturn [{ json: { ...escolhido, tema: tema || escolhido.tema, origem: \"banco\" } }];\n"
      },
      "notes": "Fallback sem custo: usado com usar_ia=false ou quando a IA falha."
    },
    {
      "id": "2b902313-b460-5494-b98b-861c762a96dd",
      "name": "Normalizar roteiro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        240
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst r = $json;\nconst limpa = (s, n) => (s || '').toString().replace(/\\s+/g, ' ').trim().slice(0, n);\nconst cenas = (r.cenas || []).slice(0, 5).map(c => ({ texto: limpa(c.texto, 90), narracao: limpa(c.narracao || c.texto, 300) }))\n  .filter(c => c.texto);\nif (!r.gancho || cenas.length < 2) throw new Error('Roteiro inválido: precisa de gancho e ao menos 2 cenas');\nconst hashtags = [...new Set((r.hashtags || []).map(h => '#' + h.replace(/^#/, '').replace(/\\s+/g, '')))].slice(0, 6);\nconst titulo = (limpa(r.gancho, 150) + '\\n\\n' + hashtags.join(' ')).slice(0, 2200);\nreturn [{ json: { tema: r.tema || cfg.tema, gancho: limpa(r.gancho, 100), cenas, cta: limpa(r.cta, 90),\n  hashtags, titulo, marca: cfg.marca, origem: r.origem } }];\n"
      }
    },
    {
